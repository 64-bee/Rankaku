# Fins de ligne LF partout (dépôt et copie de travail), quel que soit l'OS
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaires : aucune conversion
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.jar binary
